# =============================================================================
# You supply the script. Nothing here writes your script.
# The text model below writes the IMAGE PROMPTS -- one per beat, ~400 per video.
# =============================================================================

# ---- OpenAI: transcription (timing), image prompts, and optionally images ----
# One key here is enough to run the whole app.        https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ---- Image generation: set the key for whichever you want to use ----
# fal.ai  (cheapest + fastest for 300-400 images)     https://fal.ai/dashboard/keys
FAL_KEY=
# Replicate                                           https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
# (OpenAI images use OPENAI_API_KEY above)

# ---- Optional: use Claude to write the prompts instead of OpenAI ----
ANTHROPIC_API_KEY=

# ---- Optional overrides ----
# Which text model writes the image prompts: openai | anthropic
# DIRECTOR_PROVIDER=openai
# OPENAI_TEXT_MODEL=gpt-4o          # gpt-4o-mini is far cheaper, slightly blunter prompts
# DIRECTOR_MODEL=claude-opus-5      # only used when DIRECTOR_PROVIDER=anthropic

# Which image API to use by default: fal | replicate | openai
# DEFAULT_IMAGE_PROVIDER=fal
# FAL_MODEL=fal-ai/flux/dev
# REPLICATE_MODEL=black-forest-labs/flux-dev
# OPENAI_IMAGE_MODEL=gpt-image-1

# WHISPER_MODEL=whisper-1
# IMAGE_CONCURRENCY=6
# STORAGE_DIR=./storage
