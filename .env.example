# ---- Director (writes the image prompts). Required. ----
ANTHROPIC_API_KEY=sk-ant-...

# ---- Image generation. Set the key for whichever provider you want. ----
# fal.ai  (recommended: cheapest + fastest for 300-400 images)  https://fal.ai/dashboard/keys
FAL_KEY=
# Replicate                                                    https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
# OpenAI (also used for voiceover transcription)               https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ---- Optional overrides ----
# DEFAULT_IMAGE_PROVIDER=fal
# FAL_MODEL=fal-ai/flux/dev
# REPLICATE_MODEL=black-forest-labs/flux-dev
# OPENAI_IMAGE_MODEL=gpt-image-1
# DIRECTOR_MODEL=claude-opus-5
# IMAGE_CONCURRENCY=6
# STORAGE_DIR=./storage
